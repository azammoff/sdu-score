# Copy to .env and adjust.

# Used by docker-compose.yml to create the database
POSTGRES_USER=sdu
POSTGRES_PASSWORD=sdu
POSTGRES_DB=sdu_score

# Used by the API and Alembic
DATABASE_URL=postgresql+psycopg://sdu:sdu@localhost:5432/sdu_score
ADMIN_API_KEY=sdu-admin-key

# Used by pytest (the tests wipe this database)
TEST_DATABASE_URL=postgresql+psycopg://sdu:sdu@localhost:5432/sdu_score_test
